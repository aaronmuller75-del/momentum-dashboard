<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.aaron.fub-sync</string>

    <key>ProgramArguments</key>
    <array>
        <string>/usr/bin/python3</string>
        <string>/Users/aaronmuller/Desktop/Claude/Dashboard/sync_fub_leads.py</string>
    </array>

    <!-- Run every 30 minutes -->
    <key>StartInterval</key>
    <integer>1800</integer>

    <!-- Also run once at login -->
    <key>RunAtLoad</key>
    <true/>

    <key>StandardOutPath</key>
    <string>/Users/aaronmuller/Desktop/Claude/Dashboard/fub-sync.log</string>

    <key>StandardErrorPath</key>
    <string>/Users/aaronmuller/Desktop/Claude/Dashboard/fub-sync-error.log</string>
</dict>
</plist>
